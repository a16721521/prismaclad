---
// Served by the Worker's "404-page" not-found handling for any unknown URL.
import V2Base from '../layouts/V2Base.astro';
---
<V2Base title="Page not found | Prismaclad" description="This page doesn't exist. The homepage, the process, and our research are all one click away." noindex>
  <section animate="section" class="section">
    <div class="w-layout-blockcontainer container is-subhero w-container">
      <div class="max-width-medium is-center">
        <div class="content_group">
          <div animate="item" class="badge"><div>404</div></div>
          <h1 animate="item" class="display-md">This page <span class="text-highlight">doesn&#x27;t exist.</span></h1>
          <p animate="item" class="text-color-subtle">It may have moved when the site was rebuilt. The homepage, the process, and our research are all one click away.</p>
        </div>
        <div class="spacer-md"></div>
        <a aria-label="Back to the homepage" data-wf--button--variant="orange" data-wf-component-id="1c6a4e27-54f5-1b0e-bfd8-068ace1ed623" data-wf-variant-state="bda75b55-0b71-91ee-e4ba-3757db1392c0" href="/" class="button w-variant-bda75b55-0b71-91ee-e4ba-3757db1392c0 w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="64" height="64" viewBox="0 0 256 256" class="button-icon"><polyline points="72 32 72 176 216 176" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></polyline><polyline points="168 128 216 176 168 224" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"></polyline><rect width="256" height="256" fill="none"></rect></svg><div class="button-text-wrap"><div class="button-text">Back to the homepage</div><div class="button-text">Back to the homepage</div></div></a>
      </div>
    </div>
  </section>
</V2Base>
