---
// Fluid pattern family card on the Design page (version 29 of the engine
// studies, "lava flow"). Translucent palette forms overlap and drift; the
// cursor pushes and pulls their control points and leaves a fading wake.
// The source was drawn for a 3000×300 strip; the card shows a 4:3 window
// (800×600 around the strip's centre) so the forms read at a smaller scale.
// Pauses when the tab is hidden; holds still under prefers-reduced-motion
// except while hovered.
interface Props {
  label?: string;
}
const { label = 'Translucent lava-like forms overlap and blend. Moving the cursor pushes and pulls the fluid shapes, leaving a slowly fading wake.' } = Astro.props;
