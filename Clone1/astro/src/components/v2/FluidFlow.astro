  s.cx=s.points.reduce((v,p)=>v+p[0],0)/s.points.length;s.cy=s.points.reduce((v,p)=>v+p[1],0)/s.points.length;s.phase=random(i+7)*Math.PI*2;
 }
 function spline(points,smooth){
  let d=`M ${points[0][0]} ${points[0][1]}`;const n=points.length;
  for(let i=0;i<n;i++){const p0=points[(i+n-1)%n],p1=points[i],p2=points[(i+1)%n],p3=points[(i+2)%n];
   const a=[p1[0]+(p2[0]-p0[0])*smooth/6,p1[1]+(p2[1]-p0[1])*smooth/6],b=[p2[0]-(p3[0]-p1[0])*smooth/6,p2[1]-(p3[1]-p1[1])*smooth/6];
   d+=` C ${a[0].toFixed(2)} ${a[1].toFixed(2)},${b[0].toFixed(2)} ${b[1].toFixed(2)},${p2[0].toFixed(2)} ${p2[1].toFixed(2)}`;
  }return d+' Z';
 }
 function proximity(s,p){const dx=(s.cx-p.x)/450,dy=(Math.max(0,Math.min(300,s.cy))-p.y)/300;return Math.exp(-dx*dx-dy*dy);}
 function frame(now){raf=0;if(document.hidden)return;const dt=last?Math.min(.06,(now-last)/1000):0;last=now;elapsed+=dt;
  const follow=1-Math.exp(-dt*9),gain=1-Math.exp(-dt*5);
