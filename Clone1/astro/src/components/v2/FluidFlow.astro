 function resume(){if(!raf){last=0;raf=requestAnimationFrame(frame);}}
 function point(e){const r=svg.getBoundingClientRect();const vb=svg.viewBox.baseVal;pointer.x=vb.x+(e.clientX-r.left)/r.width*vb.width;pointer.y=vb.y+(e.clientY-r.top)/r.height*vb.height;const tail=trail[trail.length-1];if(!tail||Math.hypot(pointer.x-tail.x,pointer.y-tail.y)>25){trail.push({...pointer,life:1});if(trail.length>64)trail.shift();}}
