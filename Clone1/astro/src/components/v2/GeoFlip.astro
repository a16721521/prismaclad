---
// Geometric pattern family card on the Design page (version 25 of the
// engine studies, "flipping rectangles"). Split rectangles in a sampled
// site palette turn over horizontally or vertically in place and settle into
// new arrangements; hovering triggers nearby flips. The 5:1 field is
// wrapped into two stacked bands to fill the card's 4:3 slot at a smaller
// tile size. Pauses when the tab is hidden; holds
// still under prefers-reduced-motion except while hovered.
interface Props {
  label?: string;
}
const { label = 'Colored rectangles flipping horizontally and vertically in place, settling into new arrangements. Hover to trigger nearby flips.' } = Astro.props;
---

<div class="pc-geo" data-geo-flip>
  <canvas role="img" aria-label={label}></canvas>
</div>

<style>
  .pc-geo {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-bottom: 16px;
    flex: none;
  }
  .pc-geo canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

