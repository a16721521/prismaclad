---
// Production layout (v2 promoted to the root site, Oct 2026). Uses the same
// Webflow stylesheet, scripts and animation hooks as the original Cedar port.
// The v1 layout (Base.astro) only serves pages archived in src/archive-v1/.
import V2Header from '../components/v2/V2Header.astro';
import V2Footer from '../components/v2/V2Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: string;
  modified?: string;
  schema?: string;
  wfPage?: string;
  // Interior pages pass their trail (Home is added automatically) and the
  // layout emits one BreadcrumbList. See PRISMACLAD-SEO-AEO.md §4.
  breadcrumbs?: { name: string; path: string }[];
  // For pages that must not be indexed (the 404). Drops the canonical/og:url,
  // which would otherwise point every unknown URL at one fixed address.
  noindex?: boolean;
}

const {
  title,
  description = '',
  image = '/Branding/OpenGraph.png',
  type = 'website',
  published,
  modified,
  schema,
  wfPage = '6a0b1e9642d93a89def9ef67',
  breadcrumbs,
  noindex = false,
} = Astro.props;

const canonicalURL = Astro.url.href;
const socialImage = image.startsWith('http') ? image : new URL(image, Astro.site).href;
const breadcrumbSchema = breadcrumbs?.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.path, 'https://prismaclad.com').href,
      })),
    })
  : null;
const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://prismaclad.com/#organization',
  name: 'Prismaclad',
  url: 'https://prismaclad.com',
  logo: 'https://prismaclad.com/Branding/logo_long.png',
  description: 'Large-scale facade treatments for data centers and industrial buildings.',
  email: 'contact@prismaclad.com',
  sameAs: [
    'https://x.com/prismaclad',
    'https://www.linkedin.com/company/prismaclad/',
    'https://www.instagram.com/prismaclad/',
    'https://medium.com/@prismaclad',
  ],
});
---

<!doctype html>
<html data-wf-domain="prismaclad.com" data-wf-page={wfPage} data-wf-site="6a0b1e9642d93a89def9ef68" lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:site_name" content="Prismaclad" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/assets/cedar-consulting-template.webflow.shared.54aae0612.min_be692b0c.css" rel="stylesheet" type="text/css" />
    <style is:inline>html.w-mod-js:not(.w-mod-ix3) :is(.logo01_logo-image, .blog_image-overlay, .faq_answer, .faq_paragraph-container, .logo02_list, .service_body, .service_inner, .testimonial02_list.move-up, .testimonial02_list.move-down, .fade-in-animation, [animate="item"], .button-text, [dropdown="trigger"] [dropdown="menu"]) {visibility: hidden !important;}</style>
    <link rel="stylesheet" href="/assets/fonts.css" />
    <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/Branding/Favicon_light.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/Branding/Favicon_dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/Branding/Webclip.png" rel="apple-touch-icon" sizes="180x180" />
    <link id="pc-css" rel="stylesheet" href="/assets/prismaclad.css" />
    <script id="pc-analytics" is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="GtnoGrPVegpdrbKDamiExg" async></script>
    <script type="application/ld+json" set:html={orgSchema} />
    {schema && <script type="application/ld+json" set:html={schema} />}
    {breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema} />}
  </head>
  <body>
    <div class="page-wrapper">
      <V2Header />
      <div class="main-wrapper">
        <slot />
        <V2Footer />
      </div>
    </div>
    <script is:inline src="/assets/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script is:inline src="/assets/webflow.add427ca.7b2ae37f551d8e1e_5c4d56cf.js" type="text/javascript"></script>
    <script is:inline src="/assets/gsap.min_8e6c1f2e.js" type="text/javascript"></script>
    <script is:inline src="/assets/ScrollTrigger.min_3b699995.js" type="text/javascript"></script>
    <script is:inline id="pc-render-fix">(function(){var h=document.documentElement;function r(){if(!h.classList.contains("w-mod-ix3"))h.classList.add("w-mod-ix3");}window.addEventListener("load",function(){setTimeout(r,800);});setTimeout(r,2000);})();</script>
  </body>
</html>
